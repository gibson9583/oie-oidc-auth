       be advertised to the desktop Administrator launcher. -->
  <library type="SERVER" path="lib/nimbus-jose-jwt-9.37.3.jar" />
  <library type="SERVER" path="lib/jcip-annotations-1.0-1.jar" />
  <apiProvider type="SERVLET_INTERFACE" name="org.openintegrationengine.plugins.oidc.OidcAdminServletInterface" />
  <apiProvider type="SERVER_CLASS" name="org.openintegrationengine.plugins.oidc.OidcAdminServlet" />
</pluginMetaData>
