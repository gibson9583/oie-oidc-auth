# KEY REFERENCE ONLY - this file is NOT read by the plugin. The policy lives
# in the engine database, managed under Settings -> OIDC Authentication.
# Every key below can be supplied as an OIE_OIDC_* environment variable or
# org.openintegrationengine.oidc.* system property (dots/hyphens become
# underscores in env names); such overrides pin the value over the stored
# policy and are how automated deployments provision SSO.
enabled=true
discovery-url=https://identity.example.com/.well-known/openid-configuration
client-id=oie-web-administrator
username-claim=preferred_username
allowed-algorithms=RS256,RS384,RS512,ES256,ES384,ES512
clock-skew-seconds=60
max-token-age-seconds=300
jwks-cache-ttl-seconds=300
jit.enabled=false
jit.email-claim=email
jit.name-claim=name
jit.organization-claim=organization
username-prefix=
# Existing local accounts must be explicitly linked: engine-user=https://issuer.example#provider-subject
linked-accounts=
# The claim carrying role values. A dotted path descends into nested claims,
# which is how Keycloak ships roles - realm roles at realm_access.roles, client
# roles at resource_access.<client-id>.roles. Only group membership is flat.
# Whichever you pick, the mapper must have "Add to ID token" ON: this extension
# validates the ID token, and Keycloak's role mappers default to access-token
# only. A claim whose literal name contains dots is matched before the path walk.
roles.claim=groups
# Comma-separated claim=RBAC role mappings, checked in claim order.
roles.map=oie-admins=Administrator,oie-users=User
roles.default=User
roles.sync=always
# Opt-in: a claim value that exactly matches an existing RBAC role name is
# assigned without an explicit mapping. Explicit roles.map entries always win.
# Enable only when the claim is curated (e.g. a dedicated client-role mapper):
# any matching value - including Administrator - grants that role.
roles.infer=false
